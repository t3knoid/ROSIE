# ROSIE configuration. Copy to .env and change only what you need; every setting has a default.
# Full reference, including what to restart after a change: docs/rosie/configuration.md

# --- Models and GPU (llama.cpp servers) ---
LLAMA_MODELS_PATH=./models
LLAMA_CHAT_MODEL_FILE=Llama-3.2-3B-Instruct-Q4_K_M.gguf
LLAMA_EMBEDDING_MODEL_FILE=nomic-embed-text-v1.5.Q4_K_M.gguf
LLAMA_CHAT_MODEL=local-chat
LLAMA_EMBEDDING_MODEL=local-embedding
LLAMA_N_GPU_LAYERS=99
LLAMA_CTX_SIZE=10240
LLAMA_PARALLEL=1
LLAMA_EMBEDDING_UBATCH_SIZE=1024

# --- Answers and retrieval ---
CHAT_EVIDENCE_LIMIT=2
CHAT_MAX_OUTPUT_TOKENS=512
RELEVANCE_THRESHOLD=0.35
# Change after switching embedding models to re-index into an empty collection.
# QDRANT_COLLECTION=rosie_documents

# --- Documentation sources (synced at startup, on request, and by the optional host timer) ---
DOCUMENTATION_SOURCE_URL=https://homelab.refol.us/
RUNBOOK_SOURCE_URL=https://homelab.refol.us/runbooks.html
WEB_SOURCE_MAX_PAGES=100
WEB_SOURCE_TIMEOUT_SECONDS=15
WEB_SOURCE_MAX_PAGE_BYTES=2000000

# --- Scheduled sync (read by the optional host timer worker, not the app) ---
SOURCE_SYNC_ENABLED=true
SOURCE_SYNC_INTERVAL_SECONDS=3600
SOURCE_SYNC_API_URL=http://127.0.0.1:8001/api/ingest/sources
SOURCE_SYNC_TIMEOUT_SECONDS=3600

# --- Storage ---
# Host directory where POST /api/runbooks/publish writes Markdown drafts, such as a
# checkout of your runbook Git repository. Created by Docker if missing.
RUNBOOK_PUBLISH_PATH=./docs/rosie/generated-runbooks

# --- Organization and prompt context (fills placeholders in docs/rosie/system-prompt.md) ---
# ORGANIZATION_NAME=Example Homelab
# ENVIRONMENT_NAME=Home lab
# ENVIRONMENT_TYPE=Homelab
# DOCUMENTATION_SOURCES=https://homelab.refol.us/ plus local documents and uploads
# RUNBOOK_SOURCES=https://homelab.refol.us/runbooks.html plus local runbooks and uploads
# INCIDENT_SOURCES=Not configured
# ESCALATION_CONFIGURATION=Contact the homelab owner
# Other prompt settings (ARCHITECTURE_SOURCES, ACTION_POLICY, APPROVAL_POLICY, RESTRICTED_SYSTEMS,
# SENSITIVE_DATA_POLICY, DEFAULT_USER_LEVEL, ...) are listed in docs/rosie/configuration.md.

# --- Hardware status (optional p4-thermal host service) ---
# ROSIE_GPU_STATUS_PATH=/run/p4-thermal/status.json
# ROSIE_GPU_STATUS_MAX_AGE=30
